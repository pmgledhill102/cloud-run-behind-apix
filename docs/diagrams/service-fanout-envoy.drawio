        <!-- ==================== KEY FINDINGS ==================== -->
        <mxCell id="findings" value="Fan-out snapshot: 1 client &#8594; 1 Apigee instance (path-based routing, no involvement in backend scaling) &#8594; 3 services, each autoscaling independently (2-4 instances shown: payments 3, transactions 4, customer-details 2) &#8594; 9 service instances total.&#xa;Every Cloud Run instance is a 2-container pod: Envoy terminates ingress (JWT/routing) before the app container ever sees the request. 9 instances &#215; 2 containers = 9 Envoy sidecars + 9 app containers = 18 containers running for this snapshot alone." style="text;fontSize=10;fontColor=#3C4043;align=left;verticalAlign=top;fillColor=#FFF8E1;rounded=1;strokeColor=#F9A825;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;whiteSpace=wrap;" vertex="1" parent="1">
