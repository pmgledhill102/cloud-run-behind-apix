<mxfile host="app.diagrams.net" modified="2026-07-31T09:00:00.000Z">
  <diagram name="Envoy Sidecar JWT — Sequence" id="envoy-sidecar-sequence">
    <mxGraphModel dx="1422" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="Envoy Sidecar JWT Flow — Sequence (steps &#10102;–&#10109; match docs/auth/envoy-sidecar-flow.md &#167;3)" style="text;html=1;fontSize=18;fontStyle=1;align=center;fontColor=#202124;" vertex="1" parent="1">
          <mxGeometry x="200" y="10" width="1200" height="30" as="geometry"/>
        </mxCell>

        <!-- ==================== LIFELINE HEADS ==================== -->
        <mxCell id="head-client" value="vm-test (client)&#xa;signs client JWT (RS256)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;strokeWidth=2;fontStyle=1;fontSize=11;fontColor=#1A73E8;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="35" y="60" width="170" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="head-apigee" value="Apigee X runtime&#xa;flow hook + proxy cr-auth-jwt-envoy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#E91E63;strokeWidth=2;fontStyle=1;fontSize=11;fontColor=#C2185B;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="305" y="60" width="190" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="head-idp" value="cr-idp-mock&#xa;JWKS (public keys only)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#673AB7;strokeWidth=2;fontStyle=1;fontSize=11;fontColor=#4527A0;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="555" y="60" width="170" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="head-crfe" value="Cloud Run front end&#xa;IAM (before any container)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=2;fontStyle=1;fontSize=11;fontColor=#2E7D32;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="805" y="60" width="170" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="head-envoy" value="Envoy ingress container :8080&#xa;jwt_authn filter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=2;fontStyle=1;fontSize=11;fontColor=#E65100;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1065" y="60" width="170" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="head-app" value="app container 127.0.0.1:8081&#xa;middleware OFF (JWT_MODE=off)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;fontStyle=1;fontSize=11;fontColor=#1565C0;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1330" y="60" width="180" height="50" as="geometry"/>
        </mxCell>

        <!-- ==================== LIFELINES ==================== -->
        <mxCell id="ll-client" value="" style="endArrow=none;dashed=1;dashPattern=5 5;strokeColor=#9E9E9E;strokeWidth=1;html=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="120" y="110" as="sourcePoint"/><mxPoint x="120" y="840" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="ll-apigee" value="" style="endArrow=none;dashed=1;dashPattern=5 5;strokeColor=#9E9E9E;strokeWidth=1;html=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="400" y="110" as="sourcePoint"/><mxPoint x="400" y="840" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="ll-idp" value="" style="endArrow=none;dashed=1;dashPattern=5 5;strokeColor=#9E9E9E;strokeWidth=1;html=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="640" y="110" as="sourcePoint"/><mxPoint x="640" y="840" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="ll-crfe" value="" style="endArrow=none;dashed=1;dashPattern=5 5;strokeColor=#9E9E9E;strokeWidth=1;html=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="890" y="110" as="sourcePoint"/><mxPoint x="890" y="840" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="ll-envoy" value="" style="endArrow=none;dashed=1;dashPattern=5 5;strokeColor=#9E9E9E;strokeWidth=1;html=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1150" y="110" as="sourcePoint"/><mxPoint x="1150" y="840" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="ll-app" value="" style="endArrow=none;dashed=1;dashPattern=5 5;strokeColor=#9E9E9E;strokeWidth=1;html=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1420" y="110" as="sourcePoint"/><mxPoint x="1420" y="840" as="targetPoint"/></mxGeometry>
        </mxCell>

        <!-- ==================== MESSAGES ==================== -->
        <!-- 1: client -> apigee -->
        <mxCell id="msg1" value="" style="endArrow=classic;strokeColor=#9C27B0;strokeWidth=2;html=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="120" y="175" as="sourcePoint"/><mxPoint x="400" y="175" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="msg1-label" value="&#10102; GET /auth-echo-envoy&#xa;Host: api.internal.example.com&#xa;Authorization: Bearer &lt;client JWT&gt;" style="text;fontSize=9;fontColor=#6A1B9A;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="130" y="128" width="260" height="42" as="geometry"/>
        </mxCell>

        <!-- 2a: apigee -> idp JWKS fetch -->
        <mxCell id="msg2" value="" style="endArrow=classic;startArrow=classic;dashed=1;dashPattern=4 4;strokeColor=#673AB7;strokeWidth=1;html=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="400" y="215" as="sourcePoint"/><mxPoint x="640" y="215" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="msg2-label" value="JWKS fetch /.well-known/jwks.json&#xa;(MP-cached — usually no call at all)" style="text;fontSize=8;fontColor=#673AB7;align=center;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="410" y="185" width="220" height="28" as="geometry"/>
        </mxCell>

        <!-- 2b: VerifyJWT note on apigee lifeline -->
        <mxCell id="note-vj" value="&#10103; VerifyJWT — PreProxyFlowHook, runs before ANY proxy logic, on every proxy in the env:&#xa;RS256 (pinned) &#183; sig vs JWKS &#183; exp/nbf &#183; iss = https://idp.poc.internal &#183; aud = api://apigee-poc" style="text;fontSize=9;fontColor=#0D652D;align=center;fontStyle=1;fillColor=#E8F5E9;rounded=1;strokeColor=#4CAF50;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="230" y="235" width="340" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="rej1" value="" style="endArrow=classic;dashed=1;dashPattern=8 4;strokeColor=#F44336;strokeWidth=2;html=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="400" y="320" as="sourcePoint"/><mxPoint x="120" y="320" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="rej1-label" value="&#10007; 401 — steps.jwt.TokenExpired / InvalidClaim / FailedToResolveVariable&#xa;(a bad client JWT never leaves the edge)" style="text;fontSize=8;fontColor=#C62828;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="322" width="360" height="28" as="geometry"/>
        </mxCell>

        <!-- 3: mint note -->
        <mxCell id="note-mint" value="&#10104; TargetEndpoint Authentication mints Google ID token — SA apigee-poc,&#xa;aud = apigee-poc-auth (CUSTOM, fixed string), cached ~1 h&#xa;&#8594; written to X-Serverless-Authorization (client JWT stays untouched)" style="text;fontSize=9;fontColor=#E65100;align=center;fontStyle=1;fillColor=#FFF3E0;rounded=1;strokeColor=#FB8C00;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="230" y="365" width="340" height="60" as="geometry"/>
        </mxCell>

        <!-- 4: apigee -> cloud run front end -->
        <mxCell id="msg4" value="" style="endArrow=classic;strokeColor=#4CAF50;strokeWidth=2;html=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="400" y="470" as="sourcePoint"/><mxPoint x="890" y="470" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="msg4-label" value="&#10105; GET /  (BasePath stripped) &#183; Host: cr-auth-echo-envoy-&#8230;.run.app  &#8212;  over the PGA restricted VIP&#xa;Authorization: Bearer &lt;client JWT, byte-identical&gt;   +   X-Serverless-Authorization: Bearer &lt;Google ID token&gt;" style="text;fontSize=9;fontColor=#2E7D32;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="435" width="490" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="note-iam" value="IAM, before any container starts or bills:&#xa;Google sig &#183; aud = custom audience &#183; SA has run.invoker&#xa;(client JWT is opaque here)" style="text;fontSize=9;fontColor=#0D652D;align=center;fontStyle=1;fillColor=#E8F5E9;rounded=1;strokeColor=#4CAF50;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="720" y="485" width="340" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="rej2" value="" style="endArrow=classic;dashed=1;dashPattern=8 4;strokeColor=#F44336;strokeWidth=2;html=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="890" y="555" as="sourcePoint"/><mxPoint x="400" y="555" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="rej2-label" value="&#10007; 403 — no/invalid Google ID token; no container ran (kills the T3 direct-bypass path too)" style="text;fontSize=8;fontColor=#C62828;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="420" y="558" width="450" height="16" as="geometry"/>
        </mxCell>

        <!-- 5: front end -> envoy -->
        <mxCell id="msg5" value="" style="endArrow=classic;strokeColor=#1565C0;strokeWidth=2;html=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="890" y="600" as="sourcePoint"/><mxPoint x="1150" y="600" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="msg5-label" value="&#10106; BOTH auth headers forwarded&#xa;(X-Serverless-Authorization is consumed but not stripped)" style="text;fontSize=9;fontColor=#1565C0;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="880" y="568" width="280" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="note-envoy" value="&#10107; jwt_authn zero-trust re-check, from Authorization only:&#xa;RS256 sig vs INLINE JWKS (env var, no fetch) &#183; iss &#183; aud &#183; exp/nbf&#xa;(/healthz exempt — startup probe route)" style="text;fontSize=9;fontColor=#6A1B9A;align=center;fontStyle=1;fillColor=#F3E5F5;rounded=1;strokeColor=#9C27B0;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="980" y="615" width="340" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="rej3" value="" style="endArrow=classic;dashed=1;dashPattern=8 4;strokeColor=#F44336;strokeWidth=2;html=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1150" y="695" as="sourcePoint"/><mxPoint x="890" y="695" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="rej3-label" value="&#10007; 401 &#39;Jwt is expired&#39; / &#39;Jwt is missing&#39; &#8212; but 403 &#39;Audiences in Jwt are not allowed&#39;&#xa;(taxonomy differs from Apigee&#39;s uniform 401!)" style="text;fontSize=8;fontColor=#C62828;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="850" y="698" width="340" height="28" as="geometry"/>
        </mxCell>

        <!-- 6: envoy -> app -->
        <mxCell id="msg6" value="" style="endArrow=classic;strokeColor=#FB8C00;strokeWidth=2;html=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1150" y="745" as="sourcePoint"/><mxPoint x="1420" y="745" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="msg6-label" value="&#10108; plain HTTP, 127.0.0.1:8081&#xa;Authorization kept (forward: true)" style="text;fontSize=9;fontColor=#E65100;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1160" y="713" width="250" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="note-app" value="trusts the sidecar — no JWT logic runs" style="text;fontSize=8;fontColor=#5F6368;align=center;fontStyle=2;fillColor=#F5F5F5;rounded=1;strokeColor=#BDBDBD;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1310" y="758" width="220" height="22" as="geometry"/>
        </mxCell>

        <!-- 7: response -->
        <mxCell id="msg7" value="" style="endArrow=classic;dashed=1;dashPattern=6 3;strokeColor=#2E7D32;strokeWidth=2;html=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1420" y="805" as="sourcePoint"/><mxPoint x="120" y="805" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="msg7-label" value="&#10109; 200 — {&quot;jwt&quot;:{&quot;valid&quot;:true,&quot;mode&quot;:&quot;off (enforced by ingress container)&quot;}, &quot;headers_seen&quot;:{&quot;authorization&quot;:true,&quot;x_serverless_authorization&quot;:true}}" style="text;fontSize=9;fontColor=#2E7D32;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="783" width="940" height="18" as="geometry"/>
        </mxCell>

        <!-- Legend -->
        <mxCell id="legend" value="Solid arrows = request path &#183; dashed purple = JWKS fetch &#183; dashed red = rejection exits (with live-observed codes) &#183; dashed green = response.&#xa;Three verifications of two tokens: client JWT at &#10103; (Apigee) and &#10107; (Envoy); Google ID token at IAM. The app itself verifies nothing." style="text;fontSize=10;fontColor=#3C4043;align=left;verticalAlign=top;fillColor=#FFF8E1;rounded=1;strokeColor=#F9A825;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="35" y="850" width="1475" height="44" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
