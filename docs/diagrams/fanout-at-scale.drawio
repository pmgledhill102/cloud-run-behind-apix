        <mxCell id="e-p2" value="" style="endArrow=classic;strokeColor=#4CAF50;strokeWidth=2;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.024;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="svc-pay" source="svc-pay-fe" target="p2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-p3" value="" style="endArrow=classic;strokeColor=#4CAF50;strokeWidth=2;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.024;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="svc-pay" source="svc-pay-fe" target="p3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-pg" value="" style="endArrow=classic;strokeColor=#BDBDBD;strokeWidth=2;html=1;dashed=1;dashPattern=6 4;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.024;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="svc-pay" source="svc-pay-fe" target="p-ghost">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ==================== EDGES: FRONT END -> INSTANCES (transactions) ==================== -->
        <mxCell id="e-t1" value="" style="endArrow=classic;strokeColor=#4CAF50;strokeWidth=2;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.024;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="svc-txn" source="svc-txn-fe" target="t1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-t2" value="" style="endArrow=classic;strokeColor=#4CAF50;strokeWidth=2;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.024;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="svc-txn" source="svc-txn-fe" target="t2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-t3" value="" style="endArrow=classic;strokeColor=#4CAF50;strokeWidth=2;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.024;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="svc-txn" source="svc-txn-fe" target="t3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-t4" value="" style="endArrow=classic;strokeColor=#4CAF50;strokeWidth=2;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.024;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="svc-txn" source="svc-txn-fe" target="t4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ==================== EDGES: FRONT END -> INSTANCES (customer-details) ==================== -->
        <mxCell id="e-c1" value="" style="endArrow=classic;strokeColor=#4CAF50;strokeWidth=2;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.024;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="svc-cust" source="svc-cust-fe" target="c1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-c2" value="" style="endArrow=classic;strokeColor=#4CAF50;strokeWidth=2;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.024;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="svc-cust" source="svc-cust-fe" target="c2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-cg" value="" style="endArrow=classic;strokeColor=#BDBDBD;strokeWidth=2;html=1;dashed=1;dashPattern=6 4;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.024;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="svc-cust" source="svc-cust-fe" target="c-ghost">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ==================== FOOTER ==================== -->
        <mxCell id="footer" value="Fleet arithmetic at this instant:  1 client &#183; 1 Apigee instance &#183; 3 services &#183; 9 instances &#183; 18 containers &#8212; and therefore 9 Envoy proxies, each holding its own config and its own copy of the JWKS.&#xa;Sized as the PoC does (0.25 vCPU / 128 Mi), the sidecar tier costs +2.25 vCPU / +1.1 GiB across the fleet; on per-container defaults (1 vCPU / 512 Mi) the same nine cost +9 vCPU / +4.5 GiB &#8212; size the sidecar explicitly.&#xa;Nobody deploys nine Envoys: the autoscaler does, per service, and the count moves with load. A config change (JWKS rotation, issuer/audience edit) reaches them only as a new revision on each service &#8212; there is no shared control plane, which is the trade against enforcing once at the Apigee edge." style="text;fontSize=10;fontColor=#3C4043;align=left;verticalAlign=top;fillColor=#FFF8E1;rounded=1;strokeColor=#F9A825;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="832" width="1520" height="58" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
