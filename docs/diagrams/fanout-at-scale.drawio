<mxfile host="app.diagrams.net" modified="2026-08-05T09:00:00.000Z">
  <diagram name="Sidecar Fan-Out at Scale" id="fanout-at-scale">
    <mxGraphModel dx="1422" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ==================== TITLE ==================== -->
        <mxCell id="title" value="Request Fan-Out: 1 Client &#8594; 1 Apigee &#8594; 3 Cloud Run Services &#8594; 9 Instances &#8594; 9 Envoy Sidecars" style="text;html=1;fontSize=18;fontStyle=1;align=center;fontColor=#202124;" vertex="1" parent="1">
          <mxGeometry x="200" y="10" width="1200" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="Every Cloud Run instance runs two containers &#8212; Envoy ingress (jwt_authn) in front of the app. Instance count is chosen by the autoscaler, so the size of the Envoy fleet is not something you deploy. Instance counts here are illustrative; the PoC runs at --max-instances=5." style="text;html=1;fontSize=11;align=center;fontColor=#5F6368;" vertex="1" parent="1">
          <mxGeometry x="150" y="44" width="1300" height="20" as="geometry"/>
        </mxCell>

        <!-- ==================== CLIENT ==================== -->
        <mxCell id="client" value="Client &#8212; one caller" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F3F4;strokeColor=#5F6368;strokeWidth=2;verticalAlign=top;fontStyle=1;fontSize=12;fontColor=#3C4043;arcSize=8;container=1;collapsible=0;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="620" y="74" width="360" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="client-line" value="Authorization: Bearer &lt;client JWT&gt;  &#183;  Host: api.internal.example.com" style="text;fontSize=8;fontColor=#3C4043;align=center;fontFamily=Courier New;" vertex="1" parent="client">
          <mxGeometry x="10" y="26" width="340" height="16" as="geometry"/>
        </mxCell>
        <mxCell id="client-note" value="one identity, one token &#8212; fan-out happens downstream" style="text;fontSize=8;fontColor=#80868B;align=center;fontStyle=2;" vertex="1" parent="client">
          <mxGeometry x="10" y="42" width="340" height="14" as="geometry"/>
        </mxCell>

        <!-- ==================== APIGEE ==================== -->
        <mxCell id="apigee" value="Apigee X &#8212; one runtime instance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#E91E63;strokeWidth=2;verticalAlign=top;fontStyle=1;fontSize=14;fontColor=#C2185B;arcSize=4;container=1;collapsible=0;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="380" y="178" width="840" height="136" as="geometry"/>
        </mxCell>
        <mxCell id="apigee-hook" value="PreProxyFlowhook &#8594; auth-verify shared flow: VerifyJWT (RS256 pinned, JWKS cached) &#8212; the client JWT is validated ONCE here" style="text;fontSize=9;fontColor=#0D652D;align=center;fontStyle=1;fillColor=#E8F5E9;rounded=1;strokeColor=#4CAF50;whiteSpace=wrap;" vertex="1" parent="apigee">
          <mxGeometry x="20" y="26" width="800" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="proxy-pay" value="proxy: cr-payments&#xa;BasePath /payments" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8BBD0;strokeColor=#E91E63;strokeWidth=1;fontSize=9;fontColor=#3C4043;fontStyle=1;arcSize=10;" vertex="1" parent="apigee">
          <mxGeometry x="20" y="56" width="250" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="proxy-txn" value="proxy: cr-transactions&#xa;BasePath /transactions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8BBD0;strokeColor=#E91E63;strokeWidth=1;fontSize=9;fontColor=#3C4043;fontStyle=1;arcSize=10;" vertex="1" parent="apigee">
          <mxGeometry x="295" y="56" width="250" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="proxy-cust" value="proxy: cr-customer-details&#xa;BasePath /customer-details" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8BBD0;strokeColor=#E91E63;strokeWidth=1;fontSize=9;fontColor=#3C4043;fontStyle=1;arcSize=10;" vertex="1" parent="apigee">
          <mxGeometry x="570" y="56" width="250" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="apigee-hop" value="per hop out: adds X-Serverless-Authorization (Google ID token, minted as the proxy deploy SA) &#183; egress via PGA restricted VIP 199.36.153.4/30 &#183; the client&#39;s Authorization header passes through untouched" style="text;fontSize=8;fontColor=#E65100;align=center;fontStyle=1;fillColor=#FFF3E0;rounded=1;strokeColor=#FB8C00;whiteSpace=wrap;" vertex="1" parent="apigee">
          <mxGeometry x="20" y="96" width="800" height="28" as="geometry"/>
        </mxCell>

