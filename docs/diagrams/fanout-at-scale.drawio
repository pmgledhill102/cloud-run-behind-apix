        <mxCell id="c2-envoy" value="Envoy sidecar :8080&#xa;jwt_authn &#183; 0.25 vCPU / 128 Mi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#9C27B0;strokeWidth=1;fontSize=8;fontColor=#6A1B9A;fontStyle=1;arcSize=10;" vertex="1" parent="c2">
          <mxGeometry x="10" y="22" width="178" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="c2-arr" value="&#8594;" style="text;fontSize=12;fontColor=#5F6368;align=center;fontStyle=1;" vertex="1" parent="c2">
          <mxGeometry x="188" y="32" width="20" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="c2-app" value="app container&#xa;127.0.0.1:8081" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;strokeWidth=1;fontSize=8;fontColor=#1A73E8;fontStyle=1;arcSize=10;" vertex="1" parent="c2">
          <mxGeometry x="208" y="22" width="178" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="c-ghost" value="instance 3 &#8212; not running yet&#xa;when the autoscaler adds it, it adds another Envoy with it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#BDBDBD;strokeWidth=1;dashed=1;dashPattern=6 4;fontSize=8;fontColor=#9E9E9E;fontStyle=2;arcSize=8;" vertex="1" parent="svc-cust">
          <mxGeometry x="44" y="272" width="396" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="c-scale0" value="min-instances 0 &#8594; this service can scale to zero: no instance, no Envoy, no cost. The first call after idle then pays cold start for BOTH containers &#8212; the startup probe traverses Envoy &#8594; app, so readiness gates on the full path (flow doc &#167;8).&#xa;Measured: parallel start, no --depends-on &#8594; marginal cost &#8776; 0; serialised was a flat +0.65 s." style="text;fontSize=8;fontColor=#E65100;align=left;verticalAlign=top;fillColor=#FFF3E0;rounded=1;strokeColor=#FB8C00;whiteSpace=wrap;spacingLeft=8;spacingRight=8;spacingTop=5;" vertex="1" parent="svc-cust">
          <mxGeometry x="44" y="352" width="396" height="72" as="geometry"/>
        </mxCell>

        <!-- ==================== EDGES: CLIENT -> APIGEE ==================== -->
        <mxCell id="e-client" value="1.  every request, one token" style="endArrow=classic;strokeColor=#5F6368;strokeWidth=3;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=9;fontColor=#3C4043;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="client" target="apigee">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ==================== EDGES: APIGEE -> SERVICES ==================== -->
        <mxCell id="e-pay" value="2.  /payments" style="endArrow=classic;strokeColor=#E91E63;strokeWidth=3;html=1;exitX=0.15;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=9;fontColor=#C2185B;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="apigee" target="svc-pay">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-txn" value="2.  /transactions" style="endArrow=classic;strokeColor=#E91E63;strokeWidth=3;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=9;fontColor=#C2185B;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="apigee" target="svc-txn">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-cust" value="2.  /customer-details" style="endArrow=classic;strokeColor=#E91E63;strokeWidth=3;html=1;exitX=0.85;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=9;fontColor=#C2185B;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="apigee" target="svc-cust">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="note-routing" value="Routing fan-out: one proxy per service &#8212; the BasePath decides which run.app host is dialled. One Apigee instance, three targets." style="text;fontSize=8;fontColor=#C2185B;align=left;verticalAlign=top;fontStyle=2;fillColor=#FFFFFF;rounded=1;strokeColor=#F8BBD0;whiteSpace=wrap;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="326" width="300" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="note-enforcement" value="Enforcement fan-out: the token is verified ONCE at Apigee, then AGAIN inside every Envoy below (zero-trust re-validation) &#8212; 1 + 9 verifications of the same JWT, at this instant." style="text;fontSize=8;fontColor=#6A1B9A;align=left;verticalAlign=top;fontStyle=2;fillColor=#FFFFFF;rounded=1;strokeColor=#E1BEE7;whiteSpace=wrap;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="1290" y="316" width="270" height="46" as="geometry"/>
        </mxCell>

        <!-- ==================== EDGES: FRONT END -> INSTANCES (payments) ==================== -->
        <mxCell id="e-p1" value="" style="endArrow=classic;strokeColor=#4CAF50;strokeWidth=2;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.024;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="svc-pay" source="svc-pay-fe" target="p1">
