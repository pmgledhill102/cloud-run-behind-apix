<mxfile host="app.diagrams.net" modified="2026-07-30T09:00:00.000Z">
  <diagram name="Auth — Enforcement Layers" id="auth-layers">
    <mxGraphModel dx="1422" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="AuthN/AuthZ Enforcement Layers: External-Issuer JWTs with Apigee + Cloud Run" style="text;html=1;fontSize=18;fontStyle=1;align=center;fontColor=#202124;" vertex="1" parent="1">
          <mxGeometry x="200" y="10" width="1200" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="The Istio sidecar&#39;s job, redistributed: edge validation (Apigee shared flow) + hop identity (Cloud Run IAM) + fine-grained authz (service) — docs/auth/jwt-enforcement-design.md" style="text;html=1;fontSize=11;align=center;fontColor=#5F6368;" vertex="1" parent="1">
          <mxGeometry x="200" y="42" width="1200" height="20" as="geometry"/>
        </mxCell>

        <!-- Token legend -->
        <mxCell id="legend" value="Token legend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DADCE0;strokeWidth=1;verticalAlign=top;fontSize=10;fontColor=#5F6368;fontStyle=1;arcSize=6;container=1;collapsible=0;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="1240" y="15" width="330" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="legend-jwt" value="client JWT — rides Authorization end-to-end" style="text;fontSize=9;fontColor=#6A1B9A;align=left;fontStyle=1;fillColor=#F3E5F5;rounded=1;strokeColor=#9C27B0;spacingLeft=6;" vertex="1" parent="legend">
          <mxGeometry x="10" y="22" width="310" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="legend-google" value="Google ID token — X-Serverless-Authorization (per hop)" style="text;fontSize=9;fontColor=#E65100;align=left;fontStyle=1;fillColor=#FFF3E0;rounded=1;strokeColor=#FB8C00;spacingLeft=6;" vertex="1" parent="legend">
          <mxGeometry x="10" y="48" width="310" height="22" as="geometry"/>
        </mxCell>

        <!-- ==================== CLIENT ==================== -->
        <mxCell id="client" value="API Client&#xa;(has JWT from IdP)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=2;fontSize=11;fontColor=#37474F;fontStyle=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="250" width="160" height="70" as="geometry"/>
        </mxCell>

        <!-- ==================== IN-HOUSE IDP ==================== -->
        <mxCell id="idp-box" value="In-House Auth System" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#673AB7;strokeWidth=2;verticalAlign=top;fontStyle=1;fontSize=12;fontColor=#4527A0;arcSize=4;container=1;collapsible=0;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="40" y="430" width="200" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="idp-icon" value="Issuer" style="shape=mxgraph.gcp2.cloud_endpoints;fillColor=#B39DDB;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=10;fontColor=#3C4043;fontStyle=1;" vertex="1" parent="idp-box">
          <mxGeometry x="66" y="35" width="68" height="53" as="geometry"/>
        </mxCell>
        <mxCell id="idp-desc" value="OAuth2/OIDC flow issues JWTs&#xa;JWKS endpoint (public keys)" style="text;fontSize=9;fontColor=#5F6368;align=center;" vertex="1" parent="idp-box">
          <mxGeometry x="10" y="105" width="180" height="30" as="geometry"/>
        </mxCell>

        <!-- ==================== APIGEE X ==================== -->
        <mxCell id="apigee-box" value="Apigee X" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#E91E63;strokeWidth=2;verticalAlign=top;fontStyle=1;fontSize=16;fontColor=#C2185B;arcSize=4;container=1;collapsible=0;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="310" y="140" width="360" height="400" as="geometry"/>
        </mxCell>
        <mxCell id="flowhook-chip" value="env FLOW HOOK — runs on EVERY proxy, teams cannot opt out" style="text;fontSize=9;fontColor=#0D652D;align=center;fontStyle=1;fillColor=#E8F5E9;rounded=1;strokeColor=#4CAF50;" vertex="1" parent="apigee-box">
          <mxGeometry x="20" y="35" width="320" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="sharedflow" value="Shared flow: auth-verify (platform-owned, patched fleet-wide in one deploy)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DADCE0;strokeWidth=1;dashed=1;dashPattern=5 5;verticalAlign=top;fontSize=10;fontColor=#5F6368;fontStyle=1;arcSize=6;container=1;collapsible=0;spacingTop=2;" vertex="1" parent="apigee-box">
          <mxGeometry x="20" y="70" width="320" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="sf-step1" value="&#10102; VerifyJWT: signature (JWKS, cached) · exp/nbf · iss · aud" style="text;fontSize=9;fontColor=#3C4043;align=left;spacingLeft=6;" vertex="1" parent="sharedflow">
          <mxGeometry x="10" y="35" width="300" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="sf-step2" value="scope → operation (coarse authz) · quota / spike arrest" style="text;fontSize=9;fontColor=#3C4043;align=left;spacingLeft=6;" vertex="1" parent="sharedflow">
          <mxGeometry x="10" y="62" width="300" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="sf-step3" value="(upgrade path: revocation deny-list — edge-only is sound&#xa;because IAM closes the path around the edge)" style="text;fontSize=8;fontColor=#80868B;align=left;spacingLeft=6;fontStyle=2;" vertex="1" parent="sharedflow">
          <mxGeometry x="10" y="90" width="300" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="apigee-proxy" value="API proxies (per domain)" style="shape=mxgraph.gcp2.api_monetization;fillColor=#F8BBD0;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=10;fontColor=#3C4043;fontStyle=1;" vertex="1" parent="apigee-box">
          <mxGeometry x="146" y="220" width="68" height="53" as="geometry"/>
        </mxCell>
        <mxCell id="mint-chip" value="&#10103; mint Google ID token as proxy SA (cached ≈1h)&#xa;→ X-Serverless-Authorization  (client JWT stays in Authorization)" style="text;fontSize=9;fontColor=#E65100;align=center;fontStyle=1;fillColor=#FFF3E0;rounded=1;strokeColor=#FB8C00;whiteSpace=wrap;" vertex="1" parent="apigee-box">
          <mxGeometry x="20" y="300" width="320" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="apigee-note" value="Blind spot: only traffic that comes THROUGH Apigee —&#xa;contributes nothing against direct callers (T3)" style="text;fontSize=8;fontColor=#C62828;align=center;fontStyle=2;" vertex="1" parent="apigee-box">
          <mxGeometry x="20" y="355" width="320" height="30" as="geometry"/>
        </mxCell>

        <!-- ==================== GOOGLE NETWORK ==================== -->
        <mxCell id="google-net" value="Google network" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=2;verticalAlign=top;fontStyle=1;fontSize=12;fontColor=#2E7D32;arcSize=4;container=1;collapsible=0;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="710" y="250" width="170" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="pga-icon" value="PGA restricted VIP&#xa;199.36.153.4/30" style="shape=mxgraph.gcp2.cloud_network;fillColor=#A5D6A7;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=9;fontColor=#3C4043;fontStyle=1;" vertex="1" parent="google-net">
          <mxGeometry x="51" y="40" width="68" height="53" as="geometry"/>
        </mxCell>

        <!-- ==================== CLOUD RUN ==================== -->
        <mxCell id="cr-box" value="Cloud Run" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;verticalAlign=top;fontStyle=1;fontSize=16;fontColor=#1565C0;arcSize=4;container=1;collapsible=0;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="940" y="140" width="430" height="470" as="geometry"/>
        </mxCell>
        <mxCell id="cr-frontend" value="Cloud Run front end (Google-managed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DADCE0;strokeWidth=1;dashed=1;dashPattern=5 5;verticalAlign=top;fontSize=10;fontColor=#5F6368;fontStyle=1;arcSize=6;container=1;collapsible=0;spacingTop=2;" vertex="1" parent="cr-box">
          <mxGeometry x="20" y="35" width="390" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="iam-gate" value="&#10104; IAM gate: Google ID token valid AND caller has run.invoker&#xa;(proxy SA only) — rejects BEFORE any container starts or bills" style="text;fontSize=9;fontColor=#E65100;align=center;fontStyle=1;fillColor=#FFF3E0;rounded=1;strokeColor=#FB8C00;whiteSpace=wrap;" vertex="1" parent="cr-frontend">
          <mxGeometry x="15" y="25" width="360" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="iam-note" value="The ONLY platform-enforced per-service control — closes T3 + T4" style="text;fontSize=8;fontColor=#0D652D;align=center;fontStyle=1;" vertex="1" parent="cr-frontend">
          <mxGeometry x="15" y="70" width="360" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="cr-service" value="Service container (per API, ~1000 of these)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DADCE0;strokeWidth=1;dashed=1;dashPattern=5 5;verticalAlign=top;fontSize=10;fontColor=#5F6368;fontStyle=1;arcSize=6;container=1;collapsible=0;spacingTop=2;" vertex="1" parent="cr-box">
          <mxGeometry x="20" y="150" width="390" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="cr-icon" value="" style="shape=mxgraph.gcp2.cloud_run;fillColor=#AECBFA;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=10;fontColor=#3C4043;" vertex="1" parent="cr-service">
          <mxGeometry x="161" y="30" width="68" height="53" as="geometry"/>
        </mxCell>
        <mxCell id="mw-chip" value="&#10105; shared middleware: revalidate client JWT&#xa;(defence in depth — JWKS cached in-process)" style="text;fontSize=9;fontColor=#6A1B9A;align=center;fontStyle=1;fillColor=#F3E5F5;rounded=1;strokeColor=#9C27B0;whiteSpace=wrap;" vertex="1" parent="cr-service">
          <mxGeometry x="15" y="95" width="360" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="authz-chip" value="&#10106; fine-grained authz: claims × application data&#xa;(the check NO upstream layer can ever do)" style="text;fontSize=9;fontColor=#1A73E8;align=center;fontStyle=1;fillColor=#E8F0FE;rounded=1;strokeColor=#4285F4;whiteSpace=wrap;" vertex="1" parent="cr-service">
          <mxGeometry x="15" y="140" width="360" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="cr-flags" value="--no-allow-unauthenticated · --ingress=internal · custom audience" style="text;fontSize=8;fontColor=#80868B;align=center;fontStyle=2;" vertex="1" parent="cr-service">
          <mxGeometry x="15" y="195" width="360" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="perimeter-note" value="VPC-SC perimeter = outer ring only (wide across the org — NOT authorization)" style="text;fontSize=8;fontColor=#9E9E9E;align=center;fontStyle=2;" vertex="1" parent="cr-box">
          <mxGeometry x="20" y="400" width="390" height="20" as="geometry"/>
        </mxCell>

        <!-- ==================== THREAT T3 ==================== -->
        <mxCell id="threat-box" value="In-perimeter workload (threat T3)&#xa;wide perimeter = can reach *.run.app over PGA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#F44336;strokeWidth=2;fontSize=10;fontColor=#C62828;fontStyle=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="560" y="640" width="300" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="threat-arrow" value="" style="endArrow=classic;strokeColor=#F44336;strokeWidth=2;dashed=1;dashPattern=8 4;html=1;exitX=1;exitY=0.5;entryX=0.35;entryY=1;" edge="1" parent="1" source="threat-box" target="cr-box">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="threat-label" value="direct call, bypassing Apigee&#xa;→ 403 at the front end (no Google ID token)" style="text;fontSize=9;fontColor=#C62828;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="880" y="640" width="240" height="30" as="geometry"/>
        </mxCell>

        <!-- ==================== FLOW ARROWS ==================== -->
        <mxCell id="flow-client" value="" style="endArrow=classic;strokeColor=#9C27B0;strokeWidth=3;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.35;" edge="1" parent="1" source="client" target="apigee-box">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="flow-client-label" value="Authorization:&#xa;Bearer client JWT" style="text;fontSize=9;fontColor=#6A1B9A;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="195" y="225" width="120" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="flow-apigee-pga" value="" style="endArrow=classic;strokeColor=#4CAF50;strokeWidth=3;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="apigee-box" target="google-net">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="flow-pga-cr" value="" style="endArrow=classic;strokeColor=#1565C0;strokeWidth=3;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.4;" edge="1" parent="1" source="google-net" target="cr-box">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="flow-two-tokens" value="both headers travel together:&#xa;Authorization (client JWT) + X-Serverless-Authorization (Google)" style="text;fontSize=9;fontColor=#3C4043;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="670" y="200" width="260" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="jwks-apigee" value="" style="endArrow=classic;strokeColor=#673AB7;strokeWidth=1;dashed=1;dashPattern=4 4;html=1;exitX=0;exitY=0.65;entryX=1;entryY=0.3;" edge="1" parent="1" source="apigee-box" target="idp-box">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="jwks-cr" value="" style="endArrow=classic;strokeColor=#673AB7;strokeWidth=1;dashed=1;dashPattern=4 4;html=1;exitX=0.5;exitY=1;entryX=1;entryY=0.7;" edge="1" parent="1" source="cr-box" target="idp-box">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="jwks-label" value="JWKS fetch — cached everywhere; at fleet scale use an&#xa;internal mirror or push distribution (design §7.4)" style="text;fontSize=8;fontColor=#673AB7;align=center;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="250" y="560" width="280" height="30" as="geometry"/>
        </mxCell>

        <!-- ==================== KEY FINDINGS ==================== -->
        <mxCell id="findings" value="Who does what:  &#10102; edge validation — shared flow, centrally patched (0 service redeploys), structurally unskippable via flow hook   &#10103; hop identity minted per target (cached)   &#10104; platform IAM gate — the answer to &quot;why can&#39;t someone just call the service over PGA?&quot;   &#10105; zero-trust revalidation in-service   &#10106; resource-level authz — only possible where claims meet application data&#xa;&#xa;Perf rule (§8): nothing on the warm path makes a synchronous external call — JWKS cached, minted tokens cached, revocation via pushed deny-list, per-request introspection rejected." style="text;fontSize=10;fontColor=#3C4043;align=left;verticalAlign=top;fillColor=#FFF8E1;rounded=1;strokeColor=#F9A825;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="750" width="1530" height="100" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
