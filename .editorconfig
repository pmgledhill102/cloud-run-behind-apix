root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8
indent_style = space
indent_size = 2

# Go and Python both indent by 4, but they cannot share a section: gofmt emits
# tabs and has no option not to, so a Go file left on the `[*]` default of
# `space` puts the editor and the formatter in a fight from the moment this
# file is stamped.
[*.go]
indent_style = tab
indent_size = 4

[*.py]
indent_size = 4

[Makefile]
indent_style = tab

# shfmt reads these. The keys follow the setup-shell skill. space_redirects is
# deliberately absent: this repository writes `>/dev/null`, and turning it on
# would rewrite hundreds of lines for style alone. Also deliberately NOT
# keep_padding: it is deprecated and produces cascading indentation.
[*.sh]
binary_next_line = true
switch_case_indent = true
